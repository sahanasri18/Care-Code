# ===== CareCode environment template =====
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- App ---
SECRET_KEY=change-me-to-a-long-random-string
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=30

# --- Database (PostgreSQL in production; SQLite fallback for local dev) ---
# Example Postgres: postgresql+psycopg2://user:password@host:5432/carecode
DATABASE_URL=

# --- CORS / Frontend ---
# Comma-separated allowed origins
FRONTEND_URL=http://localhost:5173

# --- Storage (profile photos, QR card cache) ---
STORAGE_DIR=./storage

# --- Email (SMTP). Leave SMTP_HOST empty to use console backend (dev/test) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=CareCode
SMTP_FROM_EMAIL=noreply@carecode.example
SMTP_USE_TLS=true

# --- Public base URL used inside QR codes & emails ---
# e.g. https://carecode.onrender.com or http://localhost:5173
PUBLIC_BASE_URL=

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
